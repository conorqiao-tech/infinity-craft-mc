{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.convergence.bow_held_original": {
      "geometry": "Array.infinity_bow_held[query.get_animation_frame >= 0 && query.get_animation_frame <= 3 ? query.get_animation_frame : 0]",
      "materials": [
        {
          "*": "variable.is_enchanted ? Material.enchanted : Material.default"
        }
      ],
      "textures": [
        "Texture.default",
        "Texture.enchanted"
      ],
      "arrays": {
        "geometries": {
          "Array.infinity_bow_held": [
            "Geometry.default",
            "Geometry.pulling_0",
            "Geometry.pulling_1",
            "Geometry.pulling_2"
          ]
        }
      }
    },
    "controller.render.convergence.crossbow_held_original": {
      "geometry": "Array.infinity_crossbow_held[query.get_animation_frame >= 0 && query.get_animation_frame <= 5 ? query.get_animation_frame : 0]",
      "materials": [
        {
          "*": "variable.is_enchanted ? Material.enchanted : Material.default"
        }
      ],
      "textures": [
        "Texture.default",
        "Texture.enchanted"
      ],
      "arrays": {
        "geometries": {
          "Array.infinity_crossbow_held": [
            "Geometry.default",
            "Geometry.pulling_0",
            "Geometry.pulling_1",
            "Geometry.pulling_2",
            "Geometry.arrow",
            "Geometry.rocket"
          ]
        }
      }
    },
    "controller.render.convergence.shield_held_original": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "variable.is_enchanted ? Material.enchanted : Material.default"
        }
      ],
      "textures": [
        "Texture.default",
        "Texture.enchanted"
      ]
    },
    "controller.render.convergence.totem_held_original": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "variable.is_enchanted ? Material.enchanted : Material.default"
        }
      ],
      "textures": [
        "Texture.default",
        "Texture.enchanted"
      ]
    }
  }
}
