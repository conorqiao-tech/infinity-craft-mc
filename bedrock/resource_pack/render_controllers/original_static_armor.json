{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.convergence.helmet_original": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "variable.is_enchanted ? Material.enchanted : Material.default"
        }
      ],
      "textures": [
        "Texture.default",
        "Texture.enchanted"
      ],
      "part_visibility": [
        {
          "head": "query.is_item_name_any('slot.armor.head', 0, 'convergence:helmet', 'infinity_catalog:helmet') && (query.is_in_ui || !query.is_first_person)"
        }
      ]
    },
    "controller.render.convergence.cuirass_original": {
      "geometry": "Geometry.default",
      "materials": [
