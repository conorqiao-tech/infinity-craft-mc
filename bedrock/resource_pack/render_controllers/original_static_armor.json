        },
        {
          "rightArm": "query.is_item_name_any('slot.armor.chest', 0, 'convergence:cuirass', 'infinity_catalog:cuirass')"
        },
        {
          "leftArm": "query.is_item_name_any('slot.armor.chest', 0, 'convergence:cuirass', 'infinity_catalog:cuirass')"
