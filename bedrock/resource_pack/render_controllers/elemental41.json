{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.convergence.elemental_helmet_elemental41": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "variable.is_enchanted ? Material.enchanted : Material.default"
        }
      ],
      "textures": [
        "Texture.default",
        "Texture.enchanted"
      ],
      "part_visibility": [
        {
          "head": "query.is_item_name_any('slot.armor.head', 0, 'convergence:elemental_helmet', 'infinity_catalog:elemental_helmet') && (query.is_in_ui || !query.is_first_person)"
        }
      ]
    },
