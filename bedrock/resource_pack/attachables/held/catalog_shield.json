{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "infinity_catalog:shield",
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/convergence/items/refresh27/shield",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.convergence.shield_held_standby"
      },
      "animations": {
        "first": "animation.convergence.shield_held_first",
        "block": "animation.convergence.shield_held_block",
        "third": "animation.convergence.shield_held_third"
      },
      "scripts": {
        "animate": [
          {
            "first": "context.is_first_person && !variable.infinity_blocking"
          },
          {
            "block": "context.is_first_person && variable.infinity_blocking"
          },
          {
            "third": "!context.is_first_person"
          }
        ],
        "pre_animation": [
          "variable.infinity_blocking_main = query.blocking && query.is_item_name_any('slot.weapon.mainhand', 'convergence:shield', 'infinity_catalog:shield');",
          "variable.infinity_blocking_off = query.blocking && (query.is_item_name_any('slot.weapon.offhand', 'convergence:shield', 'infinity_catalog:shield') && !(query.is_item_name_any('slot.weapon.mainhand', 'convergence:shield', 'infinity_catalog:shield', 'minecraft:shield')));",
          "variable.infinity_blocking = context.item_slot == 'off_hand' ? variable.infinity_blocking_off : variable.infinity_blocking_main;"
        ]
      },
      "render_controllers": [
        "controller.render.convergence.shield_held_original"
      ]
    }
  }
}
