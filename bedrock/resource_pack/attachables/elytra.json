{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "minecraft:elytra",
      "materials": {
        "default": "elytra",
        "enchanted": "elytra_glint",
        "infinity_armor": "armor",
        "infinity_armor_enchanted": "armor_enchanted"
      },
      "textures": {
        "default": "textures/models/armor/elytra",
        "enchanted": "textures/misc/enchanted_actor_glint",
        "infinity_wings": "textures/convergence/models/armor/armor_wings",
        "infinity_armor": "textures/convergence/models/armor/armor_1"
      },
      "geometry": {
        "default": "geometry.elytra",
        "infinity_armor": "geometry.humanoid.armor.chestplate"
      },
      "animations": {
        "default_controller": "controller.animation.elytra.default",
        "default": "animation.elytra.default",
        "gliding": "animation.elytra.gliding",
        "sneaking": "animation.elytra.sneaking",
        "sleeping": "animation.elytra.sleeping",
        "swimming": "animation.elytra.swimming"
      },
      "scripts": {
        "parent_setup": "variable.chest_layer_visible = 0.0;",
        "pre_animation": [
          "variable.convergence_flight_visual = query.has_property('convergence:flight_visual') ? query.property('convergence:flight_visual') : 0;"
        ],
        "animate": ["default_controller"]
      },
      "render_controllers": [
        {"controller.render.armor": "variable.convergence_flight_visual == 0"},
        {"controller.render.convergence.flight_wings": "variable.convergence_flight_visual > 0"},
        {"controller.render.convergence.flight_chest": "variable.convergence_flight_visual > 0"}
      ]
    }
  }
}
