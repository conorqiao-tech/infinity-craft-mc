#!/bin/sh
# InfinityCraft managed owner-identity hook v1. No remote access.
set -eu
common=$(git rev-parse --path-format=absolute --git-common-dir)
case "$common" in
  */.git) project=${common%/.git} ;;
  *) printf '%s\n' 'Cannot locate the shared InfinityCraft policy; operation refused.' >&2; exit 1 ;;
esac
exec python3 "$project/tools/check_git_identity.py" commit-message "$1"
