+            final int id=w.passthrough(Types.INT);w.passthrough(Types.BOOLEAN);w.passthrough(Types.STRING_ARRAY);
+            for(int i=0;i<3;i++)w.passthrough(Types.VAR_INT);for(int i=0;i<3;i++)w.passthrough(Types.BOOLEAN);
+            final int dim=w.passthrough(Types.VAR_INT);final String world=w.passthrough(Types.STRING);
+            trackWorldDataByKey1_20_5(w.user(),dim,world);w.write(Types.LONG,0L); // Removed seed: supply client biome-color salt only.
