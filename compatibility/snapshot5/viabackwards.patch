+                w.passthrough(Types.BOOLEAN);w.passthrough(Types.FLOAT);w.passthrough(Types.FLOAT);
+            }
+        });
+    }
+    @Override public void registerPackets(){
+        protocol.replaceClientbound(ClientboundPackets26_3.EXPLODE,w->{
