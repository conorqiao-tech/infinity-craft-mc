+        protocol.registerClientbound(ClientboundPackets26_3.UPDATE_MOB_EFFECT,w->{w.passthrough(Types.VAR_INT);if(w.passthrough(Types.VAR_INT)>=40)w.cancel();});
+        protocol.registerClientbound(ClientboundPackets26_3.REMOVE_MOB_EFFECT,w->{w.passthrough(Types.VAR_INT);if(w.passthrough(Types.VAR_INT)>=40)w.cancel();});
