+package com.viaversion.viabackwards.protocol.v26_4to26_3.types;
+import com.viaversion.viaversion.api.minecraft.chunks.*;
+import com.viaversion.viaversion.api.type.types.chunk.*;
+import io.netty.buffer.ByteBuf;
+/** Genuine native Snapshot5 full-resolution biome section codec. */
+public final class ChunkTypeSnapshot5 extends ChunkType1_21_5 {
+    public ChunkTypeSnapshot5(int sections,int blockBits,int biomeBits){super(new Section(blockBits,biomeBits),sections);}
+    private static final class Section extends ChunkSectionType1_18 {
+        Section(int blocks,int biomes){super(new PaletteType1_21_5(PaletteType.BLOCKS,blocks),new FullBiomePaletteType(biomes));}
+        @Override public ChunkSection read(ByteBuf b){final var s=new ChunkSectionImpl();s.setNonAirBlocksCount(b.readShort());s.setFluidCount(b.readShort());s.addPalette(PaletteType.BLOCKS,blockPaletteType.read(b));s.addPalette(PaletteType.BIOMES,biomePaletteType.read(b));return s;}
+        @Override public void write(ByteBuf b,ChunkSection s){b.writeShort(s.getNonAirBlocksCount());b.writeShort(s.getFluidCount());blockPaletteType.write(b,s.palette(PaletteType.BLOCKS));biomePaletteType.write(b,s.palette(PaletteType.BIOMES));}
+        @Override public int serializedSize(Chunk c){int n=0;for(var s:c.getSections())n+=4+blockPaletteType.serializedSize(s.palette(PaletteType.BLOCKS))+biomePaletteType.serializedSize(s.palette(PaletteType.BIOMES));return n;}
+    }
+}
