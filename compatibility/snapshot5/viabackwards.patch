+            final int biomeBits=MathUtil.ceilLog2(tracker.biomesSent());final var nativeType=new FullBiomePaletteType(biomeBits);final var oldType=new com.viaversion.viaversion.api.type.types.chunk.PaletteType1_21_5(PaletteType.BIOMES,biomeBits);
