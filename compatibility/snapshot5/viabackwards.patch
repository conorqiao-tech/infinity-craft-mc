+package com.viaversion.viabackwards.protocol.v26_4to26_3.types;
+import com.viaversion.viaversion.api.minecraft.chunks.*;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.api.type.types.VarIntType;
+import com.viaversion.viaversion.api.type.types.chunk.PaletteTypeBase;
+import com.viaversion.viaversion.util.MathUtil;
+import com.viaversion.viaversion.util.CompactArrayUtil;
+import io.netty.buffer.ByteBuf;
+/** Snapshot5 biomes use16^3 values and local palette bits1..8, unlike26.3's4^3/max3. */
+public final class FullBiomePaletteType extends PaletteTypeBase {
+    private final int globalBits;
+    public FullBiomePaletteType(int globalBits){this.globalBits=globalBits;}
+    @Override public DataPalette read(ByteBuf b){
+        final int bits=b.readUnsignedByte();if(bits>31)throw new IllegalArgumentException("Invalid native biome palette bits"+bits);
+        final var p=new DataPaletteImpl(4096);
+        if(bits==0){p.addId(Types.VAR_INT.readPrimitive(b));return p;}
+        final boolean global=bits>8;
+        if(!global){final int length=Types.VAR_INT.readPrimitive(b);if(length<1||length>(1<<bits))throw new IllegalArgumentException("Invalid native biome palette length"+length);for(int i=0;i<length;i++)p.addId(Types.VAR_INT.readPrimitive(b));}
+        final int perLong=64/bits;final long[] values=new long[(4096+perLong-1)/perLong];for(int i=0;i<values.length;i++)values[i]=b.readLong();
+        if(global)CompactArrayUtil.iterateCompactArrayWithPadding(bits,4096,values,p::setIdAt);else p.setPaletteIndexes(values,bits,perLong);
+        return p;
+    }
+    private int bits(DataPalette p){return p.size()==1?0:p.size()<=256?Math.max(1,MathUtil.ceilLog2(p.size())):globalBits;}
+    @Override public void write(ByteBuf b,DataPalette p){
+        final int bits=bits(p);b.writeByte(bits);if(bits==0){Types.VAR_INT.writePrimitive(b,p.idByIndex(0));return;}
+        if(bits<=8){Types.VAR_INT.writePrimitive(b,p.size());for(int i=0;i<p.size();i++)Types.VAR_INT.writePrimitive(b,p.idByIndex(i));}
+        for(long value:p.createPackedValues(bits,4096,bits>8))b.writeLong(value);
+    }
+    @Override public int serializedSize(DataPalette p){final int bits=bits(p);if(bits==0)return 1+VarIntType.varIntLength(p.idByIndex(0));int n=1;if(bits<=8){n+=VarIntType.varIntLength(p.size());for(int i=0;i<p.size();i++)n+=VarIntType.varIntLength(p.idByIndex(i));}return n+8*((4096+64/bits-1)/(64/bits));}
+    /** Sample the center of each4x4x4 cell; legacy clients cannot represent block-resolution biome edits. */
+    public static DataPalette coarse(DataPalette full){final var p=new DataPaletteImpl(64);for(int y=0;y<4;y++)for(int z=0;z<4;z++)for(int x=0;x<4;x++)p.setIdAt((y<<4)|(z<<2)|x,full.idAt(((y*4+2)<<8)|((z*4+2)<<4)|(x*4+2)));return p;}
+}
