+        });
+        protocol.replaceClientbound(ClientboundPackets26_3.RESPAWN,w->{
+            final int dim=w.passthrough(Types.VAR_INT);final String world=w.passthrough(Types.STRING);
+            trackWorldDataByKey1_20_5(w.user(),dim,world);w.write(Types.LONG,0L);tracker(w.user()).setInstaBuild(w.passthrough(Types.VAR_INT)==1);
