+    }
+    private PotionEffect[] safeEffects(PotionEffect[] all){final var filtered=Arrays.stream(all).filter(e->e.effect()<40).toArray(PotionEffect[]::new);return filtered.length==all.length?all:filtered;}
+    private ConsumeEffect<?>[] safeConsumeEffects(ConsumeEffect<?>[] all){
