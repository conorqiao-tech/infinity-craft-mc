+        for(int n=0;n<all.length;n++){final var effect=all[n];ConsumeEffect<?> rewritten=effect;
+            if(effect.id()==0&&effect.value() instanceof ApplyStatusEffects apply){final var effects=safeEffects(apply.effects());if(effects!=apply.effects())rewritten=new ConsumeEffect<>(0,ApplyStatusEffects.TYPE,new ApplyStatusEffects(effects,apply.probability()));}
