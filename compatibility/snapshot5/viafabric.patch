diff --git a/viafabric-mc26-4/src/gametest/java/com/viaversion/fabric/audit/LegacyLoginOptionsGameTests.java b/viafabric-mc26-4/src/gametest/java/com/viaversion/fabric/audit/LegacyLoginOptionsGameTests.java
