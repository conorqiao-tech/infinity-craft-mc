+++ b/viafabric-mc26-4/src/gametest/java/com/viaversion/fabric/audit/LegacyLoginOptionsGameTests.java
@@ -0,0 +1,183 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package com.viaversion.fabric.audit;
+
+import com.mojang.authlib.GameProfile;
+import com.viaversion.fabric.common.handler.FabricDecodeHandler;
+import com.viaversion.viaversion.api.protocol.packet.State;
+import com.viaversion.viaversion.api.protocol.version.ProtocolVersion;
+import com.viaversion.viaversion.connection.UserConnectionImpl;
+import com.viaversion.viaversion.platform.ViaDecodeHandler;
+import com.viaversion.viaversion.platform.ViaEncodeHandler;
+import com.viaversion.viaversion.protocol.ProtocolPipelineImpl;
+import io.netty.buffer.Unpooled;
+import io.netty.channel.Channel;
+import io.netty.channel.ChannelHandlerContext;
+import io.netty.channel.ChannelInitializer;
+import io.netty.channel.ChannelOutboundHandlerAdapter;
+import io.netty.channel.ChannelPromise;
+import io.netty.channel.embedded.EmbeddedChannel;
+import java.net.InetSocketAddress;
+import java.net.SocketAddress;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.OptionalInt;
+import java.util.UUID;
+import net.fabricmc.fabric.api.gametest.v1.GameTest;
+import net.minecraft.SharedConstants;
+import net.minecraft.gametest.framework.GameTestHelper;
+import net.minecraft.network.Connection;
+import net.minecraft.network.ConnectionProtocol;
+import net.minecraft.network.UnconfiguredPipelineHandler;
+import net.minecraft.network.VarInt;
+import net.minecraft.network.protocol.Packet;
+import net.minecraft.network.protocol.PacketFlow;
+import net.minecraft.network.protocol.login.ClientboundKeyPacket;
+import net.minecraft.network.protocol.login.ClientboundLoginDisconnectPacket;
+import net.minecraft.network.protocol.login.ClientboundLoginFinishedPacket;
+import net.minecraft.network.protocol.login.ClientboundSetupCompressionPacket;
+import net.minecraft.network.protocol.login.ConnectionOptionsPacket;
+import net.minecraft.network.protocol.login.LoginProtocols;
+import net.minecraft.network.protocol.login.ServerboundHelloPacket;
+import net.minecraft.network.protocol.login.ServerboundLoginAcknowledgedPacket;
+import net.minecraft.network.protocol.configuration.ServerConfigurationPacketListener;
+import net.minecraft.server.network.ServerLoginPacketListenerImpl;
+
+/** Actual native constructor/mixins/codec/ACK boundary; not a claim of authenticated Bedrock login. */
+public class LegacyLoginOptionsGameTests {
+    private static final class Fixture implements AutoCloseable {
+        final Connection connection = new Connection(PacketFlow.SERVERBOUND) {
+            @Override public SocketAddress getRemoteAddress() {
+                return new InetSocketAddress("127.0.0.1", 0);
+            }
+        };
+        final List<Packet<?>> sent = new ArrayList<>();
+        final EmbeddedChannel channel;
+        final ServerLoginPacketListenerImpl listener;
+
+        Fixture(GameTestHelper test, boolean legacy) {
+            channel = new EmbeddedChannel(new ChannelInitializer<Channel>() {
+                @Override protected void initChannel(Channel ch) {
+                    Connection.configureSerialization(ch.pipeline(), PacketFlow.SERVERBOUND, false, null);
+                    ch.pipeline().replace("decoder", "inbound_config", new UnconfiguredPipelineHandler.Inbound());
+                    connection.configurePacketHandler(ch.pipeline());
+                    var user = new UserConnectionImpl(ch, false);
+                    new ProtocolPipelineImpl(user);
+                    var nativeVersion = ProtocolVersion.getProtocol(SharedConstants.getCurrentVersion().protocolVersion());
+                    user.getProtocolInfo().setServerProtocolVersion(nativeVersion);
+                    user.getProtocolInfo().setProtocolVersion(legacy ? ProtocolVersion.v26_3 : nativeVersion);
+                    user.getProtocolInfo().setClientState(State.LOGIN);
+                    user.getProtocolInfo().setServerState(State.LOGIN);
+                    // Exercise native wire codecs. The actual cross-version packet remapper is tested separately.
+                    user.setActive(false);
+                    ch.pipeline().addBefore("outbound_config", ViaEncodeHandler.NAME, new ViaEncodeHandler(user));
+                    ch.pipeline().addBefore("inbound_config", ViaDecodeHandler.NAME, new FabricDecodeHandler(user));
+                    ch.pipeline().addBefore("packet_handler", "audit_native_packets", new ChannelOutboundHandlerAdapter() {
+                        @Override public void write(ChannelHandlerContext context, Object value, ChannelPromise promise) throws Exception {
+                            if (value instanceof Packet<?> packet) sent.add(packet);
+                            context.write(value, promise);
+                        }
+                    });
+                }
+            });
+            listener = new ServerLoginPacketListenerImpl(test.getLevel().getServer(), connection, false);
+            connection.setupOutboundProtocol(LoginProtocols.CLIENTBOUND);
+            connection.setupInboundProtocol(LoginProtocols.SERVERBOUND, listener);
+        }
+
+        OptionalInt requestedCompression() throws Exception {
+            var field = ServerLoginPacketListenerImpl.class.getDeclaredField("requestedCompressionThreshold");
+            field.setAccessible(true);
+            return (OptionalInt) field.get(listener);
+        }
+
+        void modelVerifiedFloodgateHandoff() throws Exception {
+            var method = ServerLoginPacketListenerImpl.class.getDeclaredMethod("startOfflineClientVerification", GameProfile.class);
+            method.setAccessible(true);
+            method.invoke(listener, new GameProfile(UUID.randomUUID(), "SnapshotProbe"));
+            // Still executes native canPlayerLogin and normal login-finished negotiation.
+            listener.tick();
+            channel.runPendingTasks();
+            channel.checkException();
+        }
+
+        void nativeAckFromWire() {
+            var packet = Unpooled.buffer();
+            var frame = Unpooled.buffer();
+            try {
+                LoginProtocols.SERVERBOUND.codec().encode(packet, ServerboundLoginAcknowledgedPacket.INSTANCE);
+                VarInt.write(frame, packet.readableBytes());
+                frame.writeBytes(packet);
+            } finally { packet.release(); }
+            channel.writeInbound(frame);
+            channel.runPendingTasks();
+            channel.checkException();
+        }
+
+        ClientboundLoginFinishedPacket loginFinished() {
+            return sent.stream().filter(ClientboundLoginFinishedPacket.class::isInstance)
+                    .map(ClientboundLoginFinishedPacket.class::cast).findFirst().orElseThrow();
+        }
+
+        @Override public void close() { channel.finishAndReleaseAll(); }
+    }
+
+    @GameTest public void translatedLegacyNativeAckSwitchesToConfigurationWithoutCompression(GameTestHelper test) throws Exception {
+        try (var fixture = new Fixture(test, true)) {
+            test.assertTrue(fixture.requestedCompression().isEmpty(), "Only this translated connection negotiates no compression");
+            fixture.modelVerifiedFloodgateHandoff();
+            test.assertTrue(fixture.sent.stream().noneMatch(ClientboundSetupCompressionPacket.class::isInstance), "No legacy compression setup is emitted");
+            test.assertValueEqual(fixture.loginFinished().options(), (byte)0, "Native login-finished flags agree with no compression");
+            test.assertTrue(fixture.connection.getPacketListener() == fixture.listener, "The server still waits for the real client ACK");
+            fixture.nativeAckFromWire();
+            // Polymer may install its early configuration listener before the final native implementation.
+            test.assertTrue(fixture.connection.getPacketListener() instanceof ServerConfigurationPacketListener,
+                    "Actual decoded ACK installs a native configuration protocol listener");
+            test.assertValueEqual(fixture.connection.getPacketListener().protocol(), ConnectionProtocol.CONFIGURATION,
+                    "The real native protocol phase is configuration after ACK");
+            test.assertTrue(fixture.channel.pipeline().get("compress") == null && fixture.channel.pipeline().get("decompress") == null, "Both native directions remain uncompressed as negotiated");
+        }
+        test.succeed();
+    }
+
+    @GameTest public void exactSnapshotClientKeepsNativeCompressionAndAppliesItOnlyAfterAck(GameTestHelper test) throws Exception {
+        int threshold = test.getLevel().getServer().getCompressionThreshold();
+        test.assertTrue(threshold >= 0, "This native fixture has a configured compression threshold");
+        try (var fixture = new Fixture(test, false)) {
+            test.assertValueEqual(fixture.requestedCompression().orElseThrow(), threshold, "Exact snapshot clients retain the normal configured threshold");
+            fixture.modelVerifiedFloodgateHandoff();
+            test.assertTrue(fixture.sent.stream().anyMatch(ClientboundSetupCompressionPacket.class::isInstance), "Native setup advertises its real compression threshold");
+            test.assertTrue(ConnectionOptionsPacket.isCompression(fixture.loginFinished().options()), "Native login-finished requests compression");
+            test.assertTrue(fixture.channel.pipeline().get("compress") == null && fixture.channel.pipeline().get("decompress") == null, "Native compression is not applied before ACK");
+            fixture.nativeAckFromWire();
+            // Polymer may install its early configuration listener before the final native implementation.
+            test.assertTrue(fixture.connection.getPacketListener() instanceof ServerConfigurationPacketListener,
+                    "Actual decoded ACK installs a native configuration protocol listener");
+            test.assertValueEqual(fixture.connection.getPacketListener().protocol(), ConnectionProtocol.CONFIGURATION,
+                    "The real native protocol phase is configuration after ACK");
+            test.assertTrue(fixture.channel.pipeline().get("compress") != null && fixture.channel.pipeline().get("decompress") != null, "Native compression is activated in both directions only after ACK");
+        }
+        test.succeed();
+    }
+
+    @GameTest public void unsupportedLegacyJavaRejectsBeforeEncryptionOrVerification(GameTestHelper test) {
+        try (var fixture = new Fixture(test, true)) {
+            fixture.listener.handleHello(new ServerboundHelloPacket("LegacyProbe", UUID.randomUUID()));
+            fixture.channel.runPendingTasks();
+            test.assertTrue(fixture.sent.stream().anyMatch(ClientboundLoginDisconnectPacket.class::isInstance), "Unsupported legacy Java receives an explicit native disconnect");
+            test.assertTrue(fixture.sent.stream().noneMatch(packet -> packet instanceof ClientboundKeyPacket || packet instanceof ClientboundLoginFinishedPacket), "No encryption challenge or verified profile is invented");
+            test.assertFalse(fixture.channel.isOpen(), "The unsupported Java path closes");
+        }
+        test.succeed();
+    }
+
+    @GameTest public void prematureLegacyAckCannotSkipNativeVerification(GameTestHelper test) {
+        try (var fixture = new Fixture(test, true)) {
+            boolean refused = false;
+            try { fixture.listener.handleLoginAcknowledgement(ServerboundLoginAcknowledgedPacket.INSTANCE); }
+            catch (IllegalStateException expected) { refused = true; }
+            test.assertTrue(refused, "Native login-state validation still refuses an ACK before login-finished");
+            test.assertTrue(fixture.connection.getPacketListener() == fixture.listener, "Premature ACK cannot install a configuration listener");
+        }
+        test.succeed();
+    }
+}
