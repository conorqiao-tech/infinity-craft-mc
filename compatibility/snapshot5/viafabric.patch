@@ -0,0 +1,30 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package com.viaversion.fabric.platform;
+
+import com.viaversion.fabric.mixin.pipeline.ConnectionChannelAccessor;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.platform.ViaDecodeHandler;
+import net.minecraft.SharedConstants;
+import net.minecraft.network.Connection;
+
+/** Per-connection negotiation; native snapshot clients keep all native options. */
+public final class LegacyLoginOptions {
+    private LegacyLoginOptions() {
+    }
+
+    public static boolean isTranslatedLegacy(Connection connection) {
+        if (connection.isMemoryConnection()) return false;
+        var channel = ((ConnectionChannelAccessor) connection).viaFabric$channel();
+        if (channel == null) return false;
+        var decoder = channel.pipeline().get(ViaDecodeHandler.class);
+        return decoder != null && isTranslatedLegacy(decoder.connection(),
+                SharedConstants.getCurrentVersion().protocolVersion());
+    }
+
+    static boolean isTranslatedLegacy(UserConnection user, int nativeProtocol) {
+        if (user.isClientSide()) return false;
+        var info = user.getProtocolInfo();
+        return info.serverProtocolVersion().getOriginalVersion() == nativeProtocol
+                && info.protocolVersion().getOriginalVersion() != nativeProtocol;
+    }
+}
