diff --git a/api/src/main/java/com/viaversion/viaversion/api/minecraft/item/data/consumable/Consumable26_4.java b/api/src/main/java/com/viaversion/viaversion/api/minecraft/item/data/consumable/Consumable26_4.java
new file mode 100644
index 0000000..7ae208e
--- /dev/null
+++ b/api/src/main/java/com/viaversion/viaversion/api/minecraft/item/data/consumable/Consumable26_4.java
@@ -0,0 +1,46 @@
+package com.viaversion.viaversion.api.minecraft.item.data.consumable;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.minecraft.Holder;
+import com.viaversion.viaversion.api.minecraft.SoundEvent;
+import com.viaversion.viaversion.api.minecraft.codec.Ops;
+import com.viaversion.viaversion.api.minecraft.item.data.EnumTypes;
+import com.viaversion.viaversion.api.protocol.Protocol;
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.util.Copyable;
+import com.viaversion.viaversion.util.Rewritable;
+import io.netty.buffer.ByteBuf;
+import org.checkerframework.checker.nullness.qual.Nullable;
+
+/** Exact 26.4-snapshot-5 consumable codec: the sound holder is optional. */
+public record Consumable26_4(float consumeSeconds, int animationType, @Nullable Holder<SoundEvent> sound,
+    boolean hasConsumeParticles, ConsumeEffect<?>[] consumeEffects) implements Copyable, Rewritable {
+    public static final Type<Consumable26_4> TYPE = new Type<>(Consumable26_4.class) {
+        @Override public Consumable26_4 read(final ByteBuf b) {
+            final float seconds = b.readFloat();
+            final int animation = Types.VAR_INT.readPrimitive(b);
+            final Holder<SoundEvent> sound = b.readBoolean() ? Types.SOUND_EVENT.read(b) : null;
+            return new Consumable26_4(seconds, animation, sound, b.readBoolean(), ConsumeEffect.ARRAY_TYPE26_3.read(b));
+        }
+        @Override public void write(final ByteBuf b, final Consumable26_4 v) {
+            b.writeFloat(v.consumeSeconds); Types.VAR_INT.writePrimitive(b, v.animationType);
+            b.writeBoolean(v.sound != null); if (v.sound != null) Types.SOUND_EVENT.write(b, v.sound);
+            b.writeBoolean(v.hasConsumeParticles); ConsumeEffect.ARRAY_TYPE26_3.write(b, v.consumeEffects);
+        }
+        @Override public void write(final Ops ops, final Consumable26_4 v) {
+            ops.writeMap(m -> m.writeOptional("consume_seconds", Types.FLOAT, v.consumeSeconds, 1.6F)
+                .writeOptional("animation", EnumTypes.ITEM_USE_ANIMATION, v.animationType, 1)
+                .writeOptional("sound", Types.SOUND_EVENT, v.sound)
+                .writeOptional("has_consume_particles", Types.BOOLEAN, v.hasConsumeParticles, true)
+                .writeOptional("on_consume_effects", ConsumeEffect.ARRAY_TYPE26_3, v.consumeEffects, new ConsumeEffect<?>[0]));
+        }
+    };
+    @Override public Consumable26_4 rewrite(final UserConnection c, final Protocol<?,?,?,?> p, final boolean clientbound) {
+        final Holder<SoundEvent> s = sound == null ? null : SoundEvent.rewriteHolder(sound, Rewritable.soundRewriteFunction(p, clientbound));
+        return new Consumable26_4(consumeSeconds, animationType, s, hasConsumeParticles, ConsumeEffect.rewrite(consumeEffects,c,p,clientbound));
+    }
+    @Override public Consumable26_4 copy() {
+        return new Consumable26_4(consumeSeconds,animationType,sound,hasConsumeParticles,Copyable.copy(consumeEffects));
+    }
+}
